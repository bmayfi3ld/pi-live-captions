# Secrets for the livecaption service. Installed as /etc/livecaption/secrets.env
# (mode 0640, root:livecaption) and never overwritten by a package upgrade.
#
# These have no command-line flags on purpose: a key passed as an argument
# lands in every ps listing and shell history on the machine.

# Key for the selected engine. Only the one matching LIVECAPTION_ENGINE is read,
# so having both here is safe.
DEEPGRAM_API_KEY=
#SPEECHMATICS_API_KEY=

# Enables the /admin clear-screen control and guards /admin with basic auth
# (username: admin). Leave unset to keep the control disabled entirely.
ADMIN_PASSWORD=
