#!/bin/sh
set -e

case "$1" in
configure)
	if ! getent passwd kiosk >/dev/null; then
		adduser --disabled-password --gecos '' kiosk
	fi

	# Disable Light Locker before desktop autostart, including on upgrades.
	# A per-user override leaves administrator desktops unchanged.
	kiosk_home=$(getent passwd kiosk | cut -d: -f6)
	install -d -o kiosk -g "$(id -gn kiosk)" "$kiosk_home/.config" "$kiosk_home/.config/autostart"
	cat >"$kiosk_home/.config/autostart/light-locker.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Light Locker
Hidden=true
EOF
	chown "kiosk:$(id -gn kiosk)" "$kiosk_home/.config/autostart/light-locker.desktop"

	display_manager=$(basename "$(cat /etc/X11/default-display-manager 2>/dev/null || true)")
	case "$display_manager" in
	gdm3)
		config=/etc/gdm3/daemon.conf
		tmp=$(mktemp)
		awk '
			BEGIN { section = 0; configured = 0 }
			/^\[daemon\]$/ {
				print
				print "AutomaticLoginEnable=true"
				print "AutomaticLogin=kiosk"
				section = configured = 1
				next
			}
			/^\[/ { section = 0 }
			section && /^[#[:space:]]*AutomaticLogin(Enable)?[[:space:]]*=/ { next }
			{ print }
			END {
				if (!configured) {
					print "\n[daemon]"
					print "AutomaticLoginEnable=true"
					print "AutomaticLogin=kiosk"
				}
			}
		' "$config" >"$tmp"
		cat "$tmp" >"$config"
		rm -f "$tmp"
		;;
	lightdm)
		install -d -m 0755 /etc/lightdm/lightdm.conf.d
		cat >/etc/lightdm/lightdm.conf.d/50-livecaption-kiosk.conf <<'EOF'
[Seat:*]
autologin-user=kiosk
autologin-user-timeout=0
EOF
		;;
	*)
		echo "livecaption-kiosk: unsupported display manager '$display_manager'; configure kiosk autologin manually" >&2
		;;
	esac

	if [ -z "$2" ]; then
		cat <<'MSG'

livecaption-kiosk is installed. Reboot to start the kiosk automatically.
URL: /etc/default/livecaption-kiosk

MSG
	fi
	;;
esac
